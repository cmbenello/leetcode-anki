{
  "manifest_version": 3,
  "name": "LeetCode Anki",
  "version": "0.6.2",
  "description": "Spaced repetition for LeetCode + NeetCode with auto-commits to a GitHub progress repo.",
  "permissions": [
    "storage",
    "webNavigation",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://*.leetcode.com/*",
    "https://neetcode.io/*",
    "https://*.neetcode.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://cmbenello.github.io/quant/*",
    "file:///*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://*.leetcode.com/*",
        "https://neetcode.io/*",
        "https://*.neetcode.io/*"
      ],
      "js": [
        "content/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://leetcode.com/*",
        "https://*.leetcode.com/*",
        "https://neetcode.io/*",
        "https://*.neetcode.io/*"
      ],
      "js": [
        "content/leetcode.js"
      ],
      "css": [
        "content/widget.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://cmbenello.github.io/quant/*",
        "file:///*"
      ],
      "js": [
        "content/quant.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://neetcode.io/*"
      ],
      "js": [
        "content/neetcode-sync.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/inject.js"
      ],
      "matches": [
        "https://leetcode.com/*",
        "https://*.leetcode.com/*",
        "https://neetcode.io/*",
        "https://*.neetcode.io/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "111"
}
